# ─── 인증정보 · 환경변수 (커밋 절대 금지) ────────────────
.env
.env.*
!.env.example
**/service-account*.json
**/*secret*
**/*credential*
**/*.pem
**/*.key

# ─── 개인정보 포함 가능 파일 ─────────────────────────────
# 인터뷰 답변·회원 명부에는 실명·연락처가 들어갈 수 있다.
# 익명화 후 커밋하거나, 아래 패턴에 맞춰 제외한다.
docs/**/개인정보*
docs/**/회원명부*
docs/**/*_원본.xlsx
docs/**/*_실명*

# ─── Office 임시 파일 ────────────────────────────────────
~$*
*.tmp

# ─── OS ─────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── 개발 단계에서 사용 ──────────────────────────────────
node_modules/
dist/
build/
.gradle/
*.log

# ─── 도구 ───────────────────────────────────────────────
.idea/
.vscode/
!.vscode/extensions.json

# Claude Code — 개인 설정은 제외, 공유 설정은 커밋
.claude/settings.local.json

# ─── 1차 푸시 범위 제한 (임시) ───────────────────────────
# 현재는 .gitignore 와 .github/ 만 저장소에 올린다.
# 문서(docs/)는 저장소를 Private 으로 전환한 뒤 아래 블록을 지우고 커밋한다.
#   - 인터뷰 답변에 운영진 실명이 포함됨
#   - 서버 AS-IS 분석에 내부 구성·포트가 포함됨
/*
!/.gitignore
!/.github/
!/.github/**
